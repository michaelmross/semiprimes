# CHECKSUMS.sha256 -- 4n/, census of one-step-Fermat semiprimes in J_n to 10^8
# Repository: https://github.com/michaelmross/semiprimes/tree/main/4n
#
# Digests are over the exact LF bytes committed to git. The repository's
# .gitattributes carries "4n/** -text", so no platform performs EOL
# translation and these values hold in a Windows checkout and inside the
# zipball that Zenodo archives from a GitHub release.
#
# Verify (run from inside 4n/):
#   sha256sum -c CHECKSUMS.sha256
#   python verify_zeros.py            # digests + structure + census re-check
# Windows PowerShell:
#   Get-FileHash <file> -Algorithm SHA256
